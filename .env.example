# Copier en `.env` et renseigner. Ne jamais versionner de vrais identifiants.
#
# Ce fichier n'est pas lu automatiquement : exportez-le avant de lancer
# (`set -a; . ./.env; set +a`), ou passez les valeurs en options
# (`--token-url`, `--client-id`, `--client-secret`).

# Hote du serveur RociaDB : un nom et un port, sans chemin.
# En production, TLS est termine par un reverse proxy en HTTP/2 de bout en
# bout, et l'URL commence alors par https://.
ROCIA_HOST=http://127.0.0.1:50051

# Partition metier visee. Ce n'est pas une frontiere de securite : n'importe
# quel client authentifie peut adresser n'importe quel tenant.
ROCIA_TENANT=demo-erp

# Identifiants OAuth2 (client credentials). Le SDK lit ces trois variables
# tout seul si `auth_client_credentials(..)` n'est pas appele et que
# `disable_auth()` ne l'est pas non plus.
#
# Attention a la portee du compte : un jeton en lecture seule est refuse sur
# les 7 RPC d'ecriture, et un jeton d'administration l'est sur les 22 — y
# compris les lectures. Un PERMISSION_DENIED sur une lecture vient presque
# toujours de la confusion entre ces deux comptes.
AUTH_TOKEN_URL=https://exemple.invalid/oauth2/token
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# Journalisation. Le SDK trace chaque RPC, sa cible et son issue.
# RUST_LOG=erp_rocia_db=info,rocia_db_sdk=debug
